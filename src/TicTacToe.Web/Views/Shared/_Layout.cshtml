<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="ttt:authenticated" content="@(User.Identity?.IsAuthenticated == true ? "true" : "false")" />
    <meta name="ttt:user-id" content="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")" />
    <title>@ViewData["Title"] - TicTacToe.Web</title>
    <script>
      // M7.5 FR-13: apply saved theme BEFORE first paint (no white flash).
      (function () {
        try {
          var t = localStorage.getItem('ttt:theme') || 'device';
          var dark = t === 'dark' || (t === 'device' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.bsTheme = dark ? 'dark' : 'light';
        } catch (e) { document.documentElement.dataset.bsTheme = 'dark'; }
      })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TicTacToe.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="ttt-header">
        <nav class="navbar navbar-expand-sm navbar-dark" aria-label="Primary">
            <div class="container ttt-nav">
                <a class="ttt-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Tic Tac Toe home">
                    <span class="ttt-brand-mark" aria-hidden="true"><span class="ttt-mark-x">X</span><span class="ttt-mark-o">O</span></span>
                    <span class="ttt-brand-text">Tic Tac Toe</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2 ttt-nav-links">
                        <li class="nav-item">
                            <a class="nav-link ttt-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Play</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link ttt-nav-link" asp-controller="History" asp-action="Index">History</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link ttt-nav-link" asp-controller="Settings" asp-action="Index">Settings</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button class="nav-link btn btn-link ttt-nav-link" type="submit">Logout</button></form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link ttt-nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link ttt-nav-link" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                        <li class="nav-item ttt-nav-tools">
                            <button class="ttt-icon-btn" id="nav-sound" type="button" aria-label="Toggle sound" title="Sound">🔊</button>
                            <button class="ttt-icon-btn" id="nav-theme" type="button" aria-label="Toggle theme" title="Theme">🌙</button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main class="container" role="main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
