@* Login — one generic error for unknown user OR wrong password (FR-14). *@
@model TicTacToe.Web.Models.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="ttt-game">
    <h1>Welcome back</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="UsernameOrEmail" class="form-label">Username or email</label>
            <input asp-for="UsernameOrEmail" class="form-control" />
            <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
            <label asp-for="RememberMe" class="form-check-label"></label>
        </div>

        <button class="btn btn-primary w-100" type="submit">Sign in</button>
    </form>
    <p class="mt-3">No account? <a href="/Account/Register">Register</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
